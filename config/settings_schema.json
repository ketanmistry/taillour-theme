[
  {
    "name": "theme_info",
    "theme_name": "Taillour Theme",
    "theme_version": "1.1.1",
    "theme_author": "Ketan Mistry",
    "theme_documentation_url": "https://taillourtheme.com/",
    "theme_support_url": "https://taillourtheme.com/"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Used in structured data."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Newsletter Popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "newsletter_popup",
        "label": "Enable newsletter popup",
        "default": false
      },
      {
        "type": "range",
        "id": "newsletter_duration",
        "label": "Time to display",
        "info": "Time is seconds before the popup is displayed.",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 0
      },
      {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Heading",
        "default": "Join the family!"
      },
      {
        "type": "inline_richtext",
        "id": "newsletter_text",
        "label": "Text",
        "default": "Sign up for access to behind the scenes updates, exclusive news, and invites to our community events."
      },
      {
        "type": "text",
        "id": "newsletter_btn_label",
        "label": "Submit button label",
        "default": "Sign up"
      }
    ]
  },
  {
    "name": "SEO",
    "settings": [
      {
        "type": "header",
        "content": "Robots Metatag",
        "info": "Applies noindex to pages."
      },
      {
        "type": "textarea",
        "id": "robots_matches",
        "label": "Page handle matches:",
        "info": "Enter each handle per line in the format '\/pages\/the-page-handle'.",
        "default": "/pages/thank-you"
      },
      {
        "type": "textarea",
        "id": "robots_beginswith",
        "label": "Page handle begins with:",
        "info": "Enter each handle per line in the format '\/pages\/string-to-match'."
      },
      {
        "type": "header",
        "content": "Canonicals",
        "info": "Add each canonical on a new line in the format `url_from_without_domain -> full_url_to` e.g. \/page\/handle -> https:\/\/DOMAIN\/page\/handle."
      },
      {
        "type": "textarea",
        "id": "canonicals_list",
        "label": "Canonicals"
      }
    ]
  }
]
