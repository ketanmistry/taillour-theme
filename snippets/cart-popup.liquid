{% style %}
#js--cart-popup {
  position: relative;
  summary {
    text-decoration: underline;
  }
}
#cart-popup-summary {
  position: absolute;
  right: 0;
  width: 400px;
  margin-top: 1rem;
  background-color: var(--white);
  border: var(--border);
  z-index: 10;
  padding: 0 0 0.5rem 0;
  text-align: left;
  display: flex;
  flex-direction: column;
}
.cart-popup-summary_item {
  display: grid;
  grid-template-columns: {{ section.settings.thumbnail_size | append: 'px' }} 1fr 50px 100px;
  align-items: center;
  gap: 0 0.5rem;
  padding: 0.75rem 0.5rem;
  font-size: 1rem;
}
.cart-popup-summary_item + .cart-popup-summary_item {
  border-top: 2px dashed var(--black);
}
.cart-popup-summary_item:hover {
  background-color: var(--cream);
}
.cart-popup-summary_item a {
  text-decoration: none;
}
.cart-popup-summary_item a:hover {
  text-decoration: underline;
}
.cart-popup-summary_price {
  text-align: right;
}
#cart-popup-summary_buttons,
#cart-popup-summary_info,
#cart-popup-summary_total {
  padding: 0.5rem;
}
.cart-popup-summary_qty {
  font-family: var(--font-stack);
  font-size: 16px;
  width: 50px;
  background-color: var(--white);
  border: 1px solid var(--black);
  padding: 0.25rem;
}
.cart-popup-summary_remove {
  background-color: rgba(0,0,0,0.1);
  font-family: var(--font-stack);
  font-size: 20px;
  color: var(--black);
  display: inline-flex;
  width: 21px;
  height: 24px;
  align-items: center;
  justify-content: center;
  line-height: 0;
  &:hover {
    background-color: var(--black);
    color: var(--white);
  }
}
#cart-popup-summary_total {
  display: flex;
  justify-content: space-between;
}
#cart-popup-summary_buttons {
  display: flex;
  gap: 1rem;
  .button {
    margin-left: 0;
    flex: 1;
  }
}
{% endstyle %}

<details id="js--cart-popup">
  <summary>Cart (<span class="js--cart-counter">{{ cart.item_count }}</span>)</summary>
  <div id="cart-popup-summary"></div>
</details>

<script>
ready(() => {
  renderCartSummary();
  ajaxAddToCart();
});

/*
 * Add item to cart and display the cart summary popup.
 */
function ajaxAddToCart() {
  const cartPopup = document.getElementById('js--cart-popup');
  document.querySelectorAll('#js--addtocart').forEach(function(btn){
    let parentForm = btn.closest('form');
    btn.addEventListener('click', function(event) {
      event.preventDefault();
      let variantId = parentForm.querySelector('input[name="id"]').value;
      let quantity = parentForm.querySelector('input[name="quantity"]').value;
      let productData = {
        'items':[
          {
            id: variantId,
            quantity: parseInt(quantity)
          }
        ]
      };
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(productData)
      })
      .then(response => {
        return response.json();
      })
      .then(cart => {
        renderCartSummary().then(function(){
          cartPopup.open = true;
          setTimeout(
            function(){cartPopup.open = false;},
            {{ section.settings.duration |  times: 1000 }}
          );
        });
      });
    });
  });
}

/*
 * Update line item quantities. Also operates the removal of a line item.
 */
function updateCartLineItem(el) {
  let key = el.dataset.key;
  let quantity = el.value;
  if (quantity !== '' && quantity >= 0) {
    let data = {
      id: key,
      quantity: quantity,
    };
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(data),
    })
      .then(response => response.json())
      .then(cart => {
        renderCartSummary();
      });
  }
}

/*
 * Refresh the cart summary.
 */
function renderCartSummary() {
  const summary = document.getElementById('cart-popup-summary');
  let template = "";
  return fetch(window.Shopify.routes.root + 'cart.js')
    .then(response => response.json())
    .then(cart => {
      // Update any cart counters.
      document.querySelectorAll('.js--cart-counter').forEach(el => {
        el.innerText = cart.item_count;
      });

      // The cart items.
      {% if section.settings.show_cart_items == true %}
      cart.items.forEach(function(item){
        template += `
          <div class="cart-popup-summary_item">
            <div class="cart-popup-summary_image">
              <a href="${item.url}">
                <img src="${item.image}"
                  width="{{ section.settings.thumbnail_size }}"
                  height="{{ section.settings.thumbnail_size }}"
                  alt="${item.title}">
              </a>
            </div>
            <div class="cart-popup-summary_title">
              <a href="${item.url}">${item.quantity} x ${item.title}</a>
            </div>
            <div>
              <input type="number"
                class="cart-popup-summary_qty"
                name="qty"
                value="${item.quantity}"
                data-id="${item.id}"
                data-key="${item.key}"
                oninput="updateCartLineItem(this);">
            </div>
            <div class="cart-popup-summary_price">
              <strong>${Shopify.formatMoney(item.line_price)}</strong>
              <button type="button"
                class="cart-popup-summary_remove"
                data-key="${item.key}"
                value="0"
                onclick="updateCartLineItem(this);">
                <span>&times;</span>
              </button>
            </div>
          </div>`;
      });
      {% endif %}

      // View cart button.
      template += `
        {% if section.settings.show_cart_total == true %}
        <div id="cart-popup-summary_total">
          <div>
            <strong>Total (${cart.item_count} items)</strong>
            <br><small>Excludes delivery</small>
          </div>
          <div><strong>${Shopify.formatMoney(cart.total_price)}</strong></div>
        </div>
        {% endif %}
        {% if section.settings.show_additional_info == true %}
          <div id="cart-popup-summary_info" class="small-text">
            {{ section.settings.additional_info }}
          </div>
        {% endif %}
        <div id="cart-popup-summary_buttons">
          <a class="button button-white" href="{{ routes.cart_url }}">
            {{ section.settings.button_label }}
          </a>
          <a class="button" href="/checkout">{{ section.settings.checkout_label }}</a>
        </div>`;
      summary.innerHTML = template;
    });
}
</script>
