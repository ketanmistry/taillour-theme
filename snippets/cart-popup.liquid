{% style %}
#js--cart-popup {
  position: relative;
  summary {
    text-decoration: underline;
  }
}
#cart-popup-summary {
  position: absolute;
  right: 0;
  width: 400px;
  margin-top: 1rem;
  background-color: var(--white);
  border: var(--border);
  z-index: 10;
  padding: 0 0 0.5rem 0;
  text-align: left;
  display: flex;
  flex-direction: column;
}
.cart-popup-summary_item {
  display: grid;
  grid-template-columns: {{ section.settings.thumbnail_size | append: 'px' }} 1fr 100px;
  align-items: center;
  gap: 0 0.5rem;
  text-decoration: none;
  padding: 0.75rem 0.5rem;
  font-size: 1rem;
}
.cart-popup-summary_item + .cart-popup-summary_item {
  border-top: 2px dashed var(--black);
}
.cart-popup-summary_item:hover {
  background-color: var(--cream);
}
.cart-popup-summary_price {
  text-align: right;
}
#cart-popup-summary_button,
#cart-popup-summary_info {
  padding: 0.5rem;
}
{% endstyle %}

<details id="js--cart-popup">
  <summary>Cart (<span class="js--cart-counter">{{ cart.item_count }}</span>)</summary>
  <div id="cart-popup-summary">
    {% for item in cart.items %}
      <a href="{{ item.url }}" class="cart-popup-summary_item">
        <div class="cart-popup-summary_image">
          <img src="{{ item.image | image_url: width: section.settings.thumbnail_size, height: section.settings.thumbnail_size }}"
               width="{{ section.settings.thumbnail_size }}"
               height="{{ section.settings.thumbnail_size }}"
               alt="{{ item.title }}">
        </div>
        <div class="cart-popup-summary_title">{{ item.quantity }} x {{ item.title }}</div>
        <div class="cart-popup-summary_price"><strong>{{ item.line_price |  money }}</strong></div>
      </a>
    {% endfor %}
    {% if section.settings.show_additional_info == true %}
      <div id="cart-popup-summary_info" class="small-text">
        {{ section.settings.additional_info }}
      </div>
    {% endif %}
    <div id="cart-popup-summary_button">
      <a class="button button-stretch" href="{{ routes.cart_url }}">
        <span id="js--cart-popup-summary_total">{{ cart.total_price | money }}</span>
        – {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</details>

<script>
ready(() => {
  ajaxAddToCart();
});
function ajaxAddToCart() {
  const cartPopup = document.getElementById('js--cart-popup');
  document.querySelectorAll('#js--addtocart').forEach(function(btn){
    let parentForm = btn.closest('form');
    btn.addEventListener('click', function(event) {
      event.preventDefault();
      let variantId = parentForm.querySelector('input[name="id"]').value;
      let quantity = parentForm.querySelector('input[name="quantity"]').value;
      // console.log({variantId, quantity});

      let productData = {
        'items':[
          {
            id: variantId,
            quantity: parseInt(quantity)
          }
        ]
      };
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(productData)
      })
      .then(response => {
        return response.json();
      })
      .then(cart => {
        refreshCartSummary().then(function(){
          cartPopup.open = true;
          setTimeout(
            function(){cartPopup.open = false;},
            6000
          );
        });
      });
    });
  });
}

/*
 * Refresh the cart summary.
 */
function refreshCartSummary() {
  const summary = document.getElementById('cart-popup-summary');
  let template = "";
  return fetch(window.Shopify.routes.root + 'cart.js')
    .then(response => response.json())
    .then(cart => {
      console.log(cart);
      document.querySelectorAll('.js--cart-counter').forEach(el=>{
        el.innerText = cart.item_count;
      });
      cart.items.forEach(function(item){
        template += `
          <a href="${item.url}" class="cart-popup-summary_item">
            <div class="cart-popup-summary_image">
              <img src="${item.image}"
                   width="{{ section.settings.thumbnail_size }}"
                   height="{{ section.settings.thumbnail_size }}"
                   alt="${item.title}">
            </div>
            <div class="cart-popup-summary_title">${item.quantity} x ${item.title}</div>
            <div class="cart-popup-summary_price"><strong>${Shopify.formatMoney(item.line_price)}</strong></div>
          </a>`;
      });
      template += `
        {% if section.settings.show_additional_info == true %}
          <div id="cart-popup-summary_info" class="small-text">
            {{ section.settings.additional_info }}
          </div>
        {% endif %}
        <div id="cart-popup-summary_button">
          <a class="button button-stretch" href="{{ routes.cart_url }}">
            <span id="js--cart-popup-summary_total">${Shopify.formatMoney(cart.total_price)}</span>
            – {{ section.settings.button_label }}
          </a>
        </div>`;
      summary.innerHTML = template;
    });
}
</script>
