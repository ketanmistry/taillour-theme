{% assign current_variant = product.selected_or_first_available_variant %}

<div id="product-cart" {{ block.shopify_attributes }}>
  {% form "product", product %}
    {%- render 'product-cart',
      form: form,
      block: block,
      current_variant: current_variant
    -%}
  {% endform %}
</div>

{% schema %}
  {
    "name": "Cart",
    "presets": [
      {
        "name": "Cart"
      }
    ],
    "settings": [
      {
        "type": "paragraph",
        "content": "⚠️ Do not add multiple instances of this block – only the first will work correctly."
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "Add to cart"
      },
      {
        "type": "checkbox",
        "id": "show_quantity",
        "label": "Show quantity field",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_accelerated_checkout_buttons",
        "label": "Show accelerated checkout buttons",
        "default": true
      }
    ]
  }
{% endschema %}
