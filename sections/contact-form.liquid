<style>
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color: {{ section.settings.background | default: '#ffffff' }}
}
</style>

<div id="{{ section.id }}" class="section-wrap" style="color:{{ section.settings.color | default:'inherit' }};">
  <div class="section">
    <div class="center">
      {% content_for 'block', type: 'heading', id: 'section-heading' %}
      {% content_for 'block', type: 'richtext', id: 'section-description' %}

      {% form 'contact', class: 'form contact-form center align-left' %}
        {% if form.posted_successfully? %}
          {% comment %}
          Redirect to thank you page when "?contact_posted=true" exists in the url.
          {% endcomment %}
          <script>
          window.location.href = "{{ section.settings.thank_you_page | default: '/pages/thank-you' }}";
          </script>
          <div class="rte">
            <p>
              <strong>Thanks for your enquiry!</strong>
            </p>
          </div>
        {% else %}
          <div class="rte">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        {% content_for 'blocks' %}

        <div class="form-row">
          <button type="submit" value="submit">
            {{ section.settings.button_label | default: "Sign up" }}
          </button>
        </div>
      {% endform %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "contact-form-section",
  "disabled_on": {
    "groups": ["*"]
  },
  "presets": [
    {
      "name": "Contact Form",
      "category": "Forms",
      "blocks": [
        {
          "type": "formfield_email",
          "settings": {
            "name": "email"
          }
        },
        {
          "type": "formfield_textarea",
          "settings": {
            "name": "body"
          }
        }
      ]
    }
  ],
  "blocks": [
    { "type": "formfield_text" },
    { "type": "formfield_textarea" },
    { "type": "formfield_email" },
    { "type": "formfield_checkbox" },
    { "type": "formfield_hidden" },
    { "type": "formfield_phone" },
    { "type": "formfield_select" },
    { "type": "richtext"}
  ],
  "settings": [
    {
      "type": "header",
      "content": "Styles"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text Colour"
    },
    {
      "type": "header",
      "content": "Form Settings"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Submit"
    },
    {
      "type": "url",
      "id": "thank_you_page",
      "label": "Thank you page",
      "info": "Set thank you page – defaults to /pages/thank-you if not set. Don't forget to update theme.liquid with noindex, or robots.txt if using different thank you page."
    }
  ]
}
{% endschema %}
