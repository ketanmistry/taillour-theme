{%- style -%}
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color:{{ section.settings.background | default: '#ffffff' }}
}
{{ section.id | prepend: '#' }} .articles-grid {
  grid-template-columns: repeat({{ section.settings.articles_per_row }}, 1fr);
}
{%- endstyle -%}

<div id="{{ section.id }}" class="section-wrap" style="color:{{ section.settings.color | default:'inherit' }};">
  <div class="section">
    {% content_for 'block', type: 'heading', id: 'section-heading' %}
    {% content_for 'block', type: 'richtext', id: 'section-description' %}

    {% assign blog_handle = section.settings.blog | default: "news" %}

    <div class="articles-grid">
      {% for article in blogs[blog_handle].articles limit: section.settings.limit %}
        render 'article-card', article: article
        {% content_for 'block', type: "_content_card", id: "article-card", closest.article: article %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Articles",
  "tag": "section",
  "class": "articles-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Articles"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "info": "Limit the number of articles displayed.",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "articles_per_row",
      "label": "Articles Per Row",
      "info": "Number of articles per row.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text Colour"
    }
  ]
}
{% endschema %}
