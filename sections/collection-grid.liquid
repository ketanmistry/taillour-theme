<style>
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color:{{ section.settings.background | default: '#ffffff' }}
}
{{ section.id | prepend: '#' }} .collections-grid {
  grid-template-columns: repeat({{ section.settings.collections_per_row }}, 1fr);
}
</style>

<div id="{{ section.id }}" class="section-wrap" style="color:{{ section.settings.color | default:'inherit' }};">
  <div class="section">
    {% content_for 'block', type: 'heading', id: 'section-heading' %}
    {% content_for 'block', type: 'richtext', id: 'section-description' %}

    <div class="collections-grid">
      {% for collection in section.settings.collections %}
        {% content_for "block", type: "_collection_card", id: "collection-card", closest.collection: collection %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections",
  "tag": "section",
  "class": "collections-section",
  "disabled_on": {
    "groups": ["*"]
  },
  "presets": [
    {
      "name": "Collections",
      "category": "Products"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections"
    },
    {
      "type": "range",
      "id": "collections_per_row",
      "label": "Collections Per Row",
      "info": "Number of collections per row.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text Colour"
    }
  ]
}
{% endschema %}
