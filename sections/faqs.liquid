{% style %}
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color:{{ section.settings.background | default: '#ffffff' }}
}
{% endstyle %}

<div id="{{ section.id }}" class="section-wrap" style="color:{{ section.settings.color | default:'inherit' }};">
  <div class="section">
    <div class="center">
      {% content_for 'block', type: 'heading', id: 'section-heading' %}
      {% content_for 'block', type: 'richtext', id: 'section-description' %}
    </div>
  </div>
  <div class="section">
    {% content_for 'blocks' %}
  </div>
</div>


{% schema %}
{
  "name": "FAQs",
  "tag": "section",
  "class": "faqs-section",
  "disabled_on": {
    "groups": ["*"]
  },
  "presets": [
    {
      "name": "FAQs",
      "category": "Text",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "title": "Vitae aut laudantium perspiciatis repellendus?",
            "content": "<p>Et vel id. Eos numquam sequi placeat et quasi corrupti assumenda. Officia numquam rerum. Excepturi velit tempora. Officiis illo distinctio quisquam minus. Enim iusto adipisci iure impedit. Accusamus doloribus soluta omnis fuga qui eius et.<\/p>"
          }
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text Colour"
    }
  ],
  "blocks": [
    { "type": "faq" }
  ]
}
{% endschema %}
