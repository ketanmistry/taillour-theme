<style>
{{ section.id | prepend: '#' }}.section-wrap:before {
  background-color:{{ section.settings.background | default: '#ffffff' }}
}
{{ section.id | prepend: '#' }}.section-wrap {
  color:{{ section.settings.color | default:'inherit' }};
}
{% unless section.settings.max_width == blank or section.settings.max_width == 0 %}
{{ section.id | prepend: '#' }} .section {
  max-width: {{ section.settings.max_width | append: 'px' }};
}
{% endunless %}
{{ section.id | prepend: '#' }} .rte {
  font-size: {{ section.settings.font_size | append: "rem" }};
}
{{ section.id | prepend: '#' }} .rte p,
{{ section.id | prepend: '#' }} .rte ul,
{{ section.id | prepend: '#' }} .rte ol {
  line-height: {{ section.settings.line_height | append: "rem" }};
}
</style>

<div id="{{ section.id }}" class="section-wrap">
  <div class="section {{ section.settings.alignment }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Rich Text",
  "tag": "section",
  "class": "text-section",
  "disabled_on": {
    "groups": ["*"]
  },
  "presets": [
    {
      "name": "Rich Text",
      "category": "Text"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type":"number",
      "id": "max_width",
      "label": "Max width (px)",
      "info": "Leave blank for full width."
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text Colour"
    }
  ],
  "blocks": [
    { "type": "heading" },
    { "type": "richtext" },
    { "type": "buttons" }
  ]
}
{% endschema %}
