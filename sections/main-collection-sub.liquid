{% liquid
# Set the linklist here. Having it as a variable means you can use
# a different linklist from the main menu if you have to (useful for
# more complex site structures).
assign menu_handle = 'main-menu'
%}

{% comment %}
Level 1
{% endcomment %}
{% for level1 in linklists[menu_handle].links %}

  {% comment %}
  Level 2
  {% endcomment %}
  {% for level2 in level1.links %}
    {% if level1.url == request.path %}
      {% liquid
      assign item_data = item
      if level2.type == "collection_link"
        assign item_data = collections[level2.object.handle]
      elsif level2.type == "product_link"
        assign item_data = level2.object
      endif
      %}

      {% comment %}
      Render collection card.
      {% endcomment %}
      {% capture collection_cards %}
        {{ collection_cards }}
        {%- liquid
        unless item_data == blank
          unless level2.object.handle == handle
            render 'subcollection-card', collection: item_data
          endunless
        endunless
        -%}
      {% endcapture %}
    {% endif %}

    {% comment %}
    Level 3
    {% endcomment %}
    {% liquid
    assign category_handle = level2.object.handle
    for level3 in level2.links
      assign collection_handle = level3.object.handle
      if category_handle == collection.handle
        assign item_data = item
        if level3.type == "collection_link"
          assign item_data = collections[level3.object.handle]
        elsif level3.type == "product_link"
          assign item_data = level3.object
        endif

        capture collection_cards
          echo collection_cards
          render 'subcollection-card', collection: item_data
        endcapture
      endif
    endfor
    %}

  {% endfor %}
{% endfor %}

{% unless collection_cards == blank %}
  <style>
  {{ section.id | prepend: '#' }} .collections-grid {
    grid-template-columns: repeat({{ section.settings.collections_per_row }}, 1fr);
  }
  </style>
  <div id="{{ section.id }}" class="section-wrap">
    <div id="subcollections" class="section">
      <div class="collections-grid">
        {{ collection_cards }}
      </div>
    </div>
  </div>
{% endunless %}

{% schema %}
{
  "name": "Collections",
  "tag": "section",
  "class": "collection-sub-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Display current collection's subcollections if applicable."
    },
    {
      "type": "range",
      "id": "collections_per_row",
      "label": "Collections Per Row",
      "info": "Number of collections per row.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
